# Every setting the API reads from the environment, with its default. None is required for
# local development. Django does not load this file; export the values in your shell or set
# them in the hosting dashboard.

# Off in production. When off, DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=1
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated. On Render the service's own hostname is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins of the front end, scheme included, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production only (DJANGO_DEBUG=0): redirect plain HTTP to HTTPS, and HSTS max-age in seconds.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_LOG_LEVEL=WARNING

# Public, keyless upstream services.
HTTP_USER_AGENT=safe-route/1.0
VALHALLA_URL=https://valhalla1.openstreetmap.de
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io
OPEN_METEO_URL=https://api.open-meteo.com
